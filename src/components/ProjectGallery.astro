---
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { userData } from "../data/userData";

const imageModules = import.meta.glob<ImageMetadata>(
  "../assets/projects/*.{webp,png,jpg,jpeg}",
  { import: "default", eager: true },
);

function resolveGalleryFile(file: string): ImageMetadata {
  const entry = Object.entries(imageModules).find(([key]) => key.endsWith(`/${file}`));
  if (!entry) {
    throw new Error(`No está la captura ${file} en src/assets/projects`);
  }
  return entry[1];
}

const galleries = await Promise.all(
  userData.projects.map(async (project) => ({
    name: project.name,
    link: project.link ?? null,
    images: await Promise.all(
      (project.gallery ?? []).map(async (image) => {
        const optimized = await getImage({
          src: resolveGalleryFile(image.file),
          width: 1440,
          format: "webp",
          quality: 80,
        });
        return { src: optimized.src, alt: image.alt };
      }),
    ),
  })),
);
---

<dialog
  id="project-gallery"
  class="gallery-dialog"
  aria-labelledby="project-gallery-title"
>
  <div class="flex h-full min-h-0 flex-col bg-ivam-bg text-ivam-text">
    <header class="flex items-center justify-between gap-4 border-b border-ivam-border px-4 py-2 sm:px-8">
      <p class="text-xs uppercase tracking-[0.22em] text-ivam-accent">Galería</p>
      <button
        type="button"
        data-gallery-close
        class="inline-flex min-h-12 min-w-12 items-center justify-center rounded-lg text-ivam-muted transition-colors hover:bg-ivam-surface hover:text-white"
        aria-label="Cerrar galería"
      >
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </header>

    <div class="grid min-h-0 flex-1 grid-cols-1 lg:grid-cols-12">
      <div
        class="relative flex min-h-[46vh] items-center justify-center bg-[#070b10] lg:col-span-8 lg:min-h-0"
        data-gallery-stage
      >
        <button
          type="button"
          data-gallery-prev
          class="absolute left-3 top-1/2 z-10 inline-flex min-h-12 min-w-12 -translate-y-1/2 items-center justify-center rounded-full border border-ivam-border bg-ivam-surface/90 text-white transition-colors hover:border-ivam-accent hover:text-ivam-accent"
          aria-label="Imagen anterior"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <img
          id="project-gallery-image"
          alt=""
          width="1440"
          height="900"
          decoding="async"
          class="h-auto max-h-[52vh] w-full object-contain lg:max-h-[calc(100dvh-6.5rem)]"
        />
        <button
          type="button"
          data-gallery-next
          class="absolute right-3 top-1/2 z-10 inline-flex min-h-12 min-w-12 -translate-y-1/2 items-center justify-center rounded-full border border-ivam-border bg-ivam-surface/90 text-white transition-colors hover:border-ivam-accent hover:text-ivam-accent"
          aria-label="Imagen siguiente"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>

      <aside class="flex flex-col gap-4 overflow-auto border-t border-ivam-border p-5 sm:p-6 lg:col-span-4 lg:border-l lg:border-t-0 lg:p-8">
        <h2 id="project-gallery-title" class="font-heading text-2xl font-semibold text-white sm:text-3xl"></h2>
        <p id="project-gallery-caption" class="leading-relaxed text-ivam-muted"></p>
        <p id="project-gallery-count" class="text-sm font-medium tracking-wide text-ivam-accent" aria-live="polite"></p>
        <div id="project-gallery-dots" class="flex flex-wrap gap-2" aria-label="Imágenes del proyecto"></div>
        <a
          id="project-gallery-link"
          class="mt-auto hidden min-h-12 items-center gap-2 text-ivam-accent transition-colors hover:text-cyan-300"
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Ver Proyecto
        </a>
      </aside>
    </div>
  </div>
</dialog>

<script id="project-gallery-data" type="application/json" is:inline set:html={JSON.stringify(galleries)} />

<script>
  type GalleryImage = { src: string; alt: string };
  type GalleryProject = { name: string; link: string | null; images: GalleryImage[] };

  const dialog = document.getElementById("project-gallery") as HTMLDialogElement | null;
  const dataNode = document.getElementById("project-gallery-data");
  const image = document.getElementById("project-gallery-image") as HTMLImageElement | null;
  const title = document.getElementById("project-gallery-title");
  const caption = document.getElementById("project-gallery-caption");
  const count = document.getElementById("project-gallery-count");
  const dots = document.getElementById("project-gallery-dots");
  const projectLink = document.getElementById("project-gallery-link") as HTMLAnchorElement | null;
  const stage = document.querySelector<HTMLElement>("[data-gallery-stage]");
  const prevButton = document.querySelector<HTMLButtonElement>("[data-gallery-prev]");
  const nextButton = document.querySelector<HTMLButtonElement>("[data-gallery-next]");

  if (dialog && dataNode && image && title && caption && count && dots && projectLink && stage && prevButton && nextButton) {
    const galleries = JSON.parse(dataNode.textContent || "[]") as GalleryProject[];
    let projectIndex = 0;
    let slideIndex = 0;
    let pointerStartX = 0;

    function currentProject(): GalleryProject | undefined {
      return galleries[projectIndex];
    }

    function show(nextSlide: number) {
      const project = currentProject();
      if (!project || project.images.length === 0) return;

      const total = project.images.length;
      slideIndex = (nextSlide + total) % total;
      const slide = project.images[slideIndex];

      image.src = slide.src;
      image.alt = slide.alt;
      title.textContent = project.name;
      caption.textContent = slide.alt;
      count.textContent = `${slideIndex + 1} / ${total}`;

      const hasMany = total > 1;
      prevButton.hidden = !hasMany;
      nextButton.hidden = !hasMany;

      if (project.link) {
        projectLink.href = project.link;
        projectLink.classList.remove("hidden");
        projectLink.classList.add("inline-flex");
      } else {
        projectLink.removeAttribute("href");
        projectLink.classList.add("hidden");
        projectLink.classList.remove("inline-flex");
      }

      dots.replaceChildren();
      project.images.forEach((item, index) => {
        const dot = document.createElement("button");
        const active = index === slideIndex;
        dot.type = "button";
        dot.className = active
          ? "h-2.5 w-6 rounded-full bg-ivam-accent"
          : "h-2.5 w-2.5 rounded-full bg-ivam-border hover:bg-ivam-muted";
        dot.setAttribute("aria-label", `Imagen ${index + 1} de ${total}: ${item.alt}`);
        if (active) dot.setAttribute("aria-current", "true");
        dot.addEventListener("click", () => show(index));
        dots.append(dot);
      });
    }

    function openGallery(index: number) {
      const project = galleries[index];
      if (!project || project.images.length === 0) return;
      projectIndex = index;
      show(0);
      if (!dialog.open) dialog.showModal();
    }

    document.querySelectorAll<HTMLButtonElement>("[data-open-gallery]").forEach((button) => {
      button.addEventListener("click", () => {
        openGallery(Number(button.dataset.openGallery));
      });
    });

    prevButton.addEventListener("click", () => show(slideIndex - 1));
    nextButton.addEventListener("click", () => show(slideIndex + 1));
    document.querySelector("[data-gallery-close]")?.addEventListener("click", () => dialog.close());

    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowRight") {
        event.preventDefault();
        show(slideIndex + 1);
      } else if (event.key === "ArrowLeft") {
        event.preventDefault();
        show(slideIndex - 1);
      }
    });

    stage.addEventListener("pointerdown", (event) => {
      pointerStartX = event.clientX;
    });

    stage.addEventListener("pointerup", (event) => {
      if (event.target instanceof Element && event.target.closest("button")) return;
      const delta = event.clientX - pointerStartX;
      if (delta <= -48) show(slideIndex + 1);
      if (delta >= 48) show(slideIndex - 1);
    });
  }
</script>

<style>
  .gallery-dialog {
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0b0f14;
    color: #e2e8f0;
  }

  .gallery-dialog::backdrop {
    background: rgb(11 15 20 / 0.78);
    backdrop-filter: blur(6px);
  }

  @media (min-width: 768px) {
    .gallery-dialog {
      width: calc(100vw - 2rem);
      height: calc(100dvh - 2rem);
      max-width: calc(100vw - 2rem);
      max-height: calc(100dvh - 2rem);
      margin: auto;
      border: 1px solid #1e293b;
      border-radius: 0.75rem;
      overflow: hidden;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-dialog::backdrop {
      backdrop-filter: none;
    }
  }
</style>
